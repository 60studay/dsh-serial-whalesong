{
  "name": "dsh-whalesong",
  "version": "2.2.2",
  "private": true,
  "type": "module",
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "刘实 (github.com/60studay)",
  "repository": {
    "type": "git",
    "url": "https://github.com/60studay/dsh-serial-whalesong.git"
  },
  "homepage": "https://github.com/60studay/dsh-serial-whalesong#readme",
  "description": "DeepSeek Harness 的串口插件：9 个工具 + 网页版，AI 与人共用一根串口线（自动匹配端口、结构化回显、定时发送、异常自动处置）",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "serial",
    "serial-port",
    "com-port",
    "uart",
    "rs232",
    "usb-serial",
    "ch340",
    "modbus",
    "ai-agent"
  ],
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "files": [
    "index.js",
    "client.js",
    "bridge.py",
    "config.json",
    "cordis.patch.yml",
    "package.json",
    "README.md",
    "LICENSE",
    "icon.png",
    "locale/*.json",
    "helpers/*.js",
    "tools/*.js",
    "serial_bridge/**/*.py",
    "web/index.html",
    "web/*.png",
    "web/*.css",
    "web/*.js",
    "web/js/*.js",
    "protocols/**",
    "vendor/**"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "meta": {
    "title": "鲸歌",
    "description": "让 AI 直接控制串口设备（AT 模块 / 底盘控制器 / Modbus / 任何 UART 设备）"
  },
  "engines": {
    "node": ">=20"
  }
}
